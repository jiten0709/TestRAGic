# --- AI provider -------------------------------------------------------------
# TestRAGic talks to one OpenAI-compatible endpoint. Setting OMNIROUTE_BASE_URL
# is what selects the OmniRoute gateway; leave it empty to use OpenAI directly.
#
#   npm i -g omniroute && omniroute        # boots the gateway on :20128
#   docker run -d -p 127.0.0.1:20128:20128 -v omniroute-data:/app/data \
#     diegosouzapw/omniroute:latest
#
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Optional. A local gateway runs with REQUIRE_API_KEY=false and accepts any string.
# Per-provider credentials live in the OmniRoute dashboard, never here.
# OMNIROUTE_API_KEY=

# Persistent model defaults. "auto" lets OmniRoute pick and handle failover.
OMNIROUTE_LLM_MODEL=auto

# Embeddings must be addressed explicitly as provider/model ("auto" is documented
# for chat only). Changing the model changes the vector width and invalidates any
# existing FAISS store. 3-small is 1536 dims, matching the current store.
OMNIROUTE_EMBEDDING_MODEL=openai/text-embedding-3-small

# Per-request timeout in seconds; also bounds the fallback chain.
OMNIROUTE_TIMEOUT=60

# Force a mode regardless of the above: omniroute | openai. Normally unset.
# TESTRAGIC_LLM_PROVIDER=omniroute

# --- OpenAI direct (used when OMNIROUTE_BASE_URL is empty) -------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# NOTE: BASE_URL is the Playwright *test target* (conftest.py), not the gateway.

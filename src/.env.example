# --- AI provider ---
# TestRAGic talks to one OpenAI-compatible endpoint. Setting OMNIROUTE_BASE_URL
# is what selects the OmniRoute gateway; leave it empty to use OpenAI directly.
#
#   npm i -g omniroute && omniroute        # boots the gateway on :20128
#   docker run -d -p 127.0.0.1:20128:20128 -v omniroute-data:/app/data \
#     diegosouzapw/omniroute:latest
#
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Optional. A local gateway runs with REQUIRE_API_KEY=false and accepts any string.
# Per-provider credentials live in the OmniRoute dashboard, never here.
# OMNIROUTE_API_KEY=your_omniroute_api_key_here

# Persistent model defaults. "auto" lets OmniRoute pick and handle failover.
OMNIROUTE_LLM_MODEL=auto

# Per-request timeout in seconds; also bounds the fallback chain.
OMNIROUTE_TIMEOUT=60

# Force a mode regardless of the above: omniroute | openai. Normally unset.
# TESTRAGIC_LLM_PROVIDER=omniroute

# --- Embeddings (local, never the gateway) ---
# OmniRoute only serves embeddings for providers it holds credentials for; a
# chat-only instance answers GET /v1/embeddings with data:[] and rejects every
# POST with 400. So vectors are produced in-process by a sentence-transformers
# model instead -- see src/utils/embeddings.py.
#
# Changing the model changes the vector width and invalidates any existing FAISS
# store. Qwen3-Embedding-0.6B is 1024 dims.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional, only needed for private models
HF_TOKEN=your_huggingface_token_here 

# cuda | mps | cpu. Unset auto-selects the best accelerator present.
# EMBEDDING_DEVICE=

# Texts per encode() batch. Lower it if the machine is memory-constrained.
# EMBEDDING_BATCH_SIZE=16

# --- Reading the picture: OCR + vision (silent screen recordings) ---
# Runs automatically when transcription fails, and on demand from the Generation
# page. OCR itself is local (RapidOCR/ONNX, weights ship in the wheel) and needs
# nothing configured; only the optional captioning step touches the gateway.
#
# The vision model is unset by default, which means captioning is OFF and only
# on-screen *text* is read. There is no default on purpose: `auto/best-vision`,
# `auto/vision` and `auto/pro-vision` are combo routes that may not be serviceable
# on a given gateway (they answer 502 on the instance this was built against),
# and a route that always fails would burn the whole fallback budget for nothing.
# Name a model that accepts images:
# OMNIROUTE_VISION_MODEL=oc/big-pickle

# Tuning, all optional. ContentDetector's own default threshold is 27, which is
# meant for film cuts -- a UI walkthrough changes far less between frames, so 12
# is the default here. frame_skip is what keeps scene detection cheap: without it
# a 47s 3024x1898 recording takes 14.3s, with skip=4 it takes 3.0s.
# OCR_SCENE_THRESHOLD=12
# OCR_FRAME_SKIP=4
# OCR_MAX_FRAMES=60
# OCR_FRAME_WIDTH=1280
# OCR_MIN_CONFIDENCE=0.5
# Captioning is ~13s per frame, so it is gated to frames OCR could not read and
# hard-capped regardless.
# OCR_VISION_MAX_FRAMES=8
# OCR_VISION_MIN_LINES=3
# OCR_VISION_MIN_CONFIDENCE=0.7
# OCR_VISION_WORKERS=4

# --- OpenAI direct (used when OMNIROUTE_BASE_URL is empty) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# NOTE: BASE_URL is the Playwright *test target* (conftest.py), not the gateway.
